@model Bai3_Validation.Models.Book
@{
    ViewData["Title"] = "Validation cơ bản";
}

<h1>BÀI 3 – Validation cơ bản</h1>

<p>Thử để trống tên hoặc nhập giá bằng 0 để xem thông báo lỗi.</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All"></div>

    <label>Tên sách</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label>Giá</label>
    <input asp-for="Price" type="number" step="0.01" />
    <span asp-validation-for="Price"></span>

    <button type="submit">Kiểm tra</button>
</form>

@if (ViewBag.Message != null)
{
    <p class="success">@ViewBag.Message</p>
}

<p><b>Kiến thức:</b> Data Annotation + ModelState.</p>
